# ============================================================
#  PedidosApi — Variáveis de ambiente locais
#
#  INSTRUÇÃO:
#    Copie este arquivo para Docker/.env e preencha os valores reais.
#    NUNCA commite o arquivo .env no repositório.
#
#  O docker-compose carrega automaticamente o arquivo .env
#  presente no mesmo diretório do arquivo docker-compose.
# ============================================================

# Senha do banco de dados SQL Server
# Em produção (Azure), este valor é injetado pelo Key Vault ou
# pela configuração do App Service — nunca em texto puro.
SQL_PASSWORD=SuaSenhaAqui
