# ============================================================
#  PedidosApi — Docker Compose override (pessoal, gitignored)
#
#  INSTRUÇÃO:
#    1. cp docker-compose.override.yml.example docker-compose.override.yml
#    2. Crie um arquivo .env na raiz com:
#         SQL_SA_PASSWORD=MinhaS3nhaLocal!
#       (o compose.yml referencia ${SQL_SA_PASSWORD} automaticamente
#        a partir do .env ou da variável de shell)
#
#  Este arquivo é carregado automaticamente pelo Docker Compose
#  e sobrepõe docker-compose.yml. NUNCA commite o arquivo gerado.
#
#  Use-o para: trocar porta, senha, montar volumes extras, etc.
# ============================================================

services:

  pedidos-api:
    # Porta alternativa — útil se 5010 já estiver ocupada
    ports:
      - "5010:8080"

    # Descomente para sobrescrever feature flags individualmente
    # environment:
    #   - FeatureManagement__NovoCalculoFrete=false

  sqlserver:
    # Porta alternativa — útil se 1433 já estiver em uso
    ports:
      - "1433:1433"
